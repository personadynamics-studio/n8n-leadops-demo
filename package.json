{
  "name": "leadops-n8n-demo",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "npm@11.19.1",
  "type": "module",
  "description": "Local, interactive n8n lead operations portfolio with explicitly simulated AI and CRM.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:site": "node scripts/build-site.mjs",
    "test:site": "node scripts/test-site.mjs",
    "start": "node app/server.mjs",
    "generate": "node scripts/build-workflow.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node scripts/test-integration.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "check": "node scripts/build-workflow.mjs --check"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "playwright": "1.65.0"
  }
}
